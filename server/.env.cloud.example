# Cloud-connected development: this machine's API talks to the REAL Firebase project. Copy to server/.env.cloud
# (git-ignored; never put real values in this file) and fill in. Steps: docs/cloud-setup.md.
#   npm run cloud:check      validates this file, contacts nothing
#   npm run server:cloud     API on http://localhost:3001, application email goes to the in-memory sink
#   npm run serve:cloud      website on http://localhost:5001 (open exactly this address, not 127.0.0.1)
NODE_ENV=cloud-dev
# Must equal projectId in public/js/firebase-config.js; the server refuses to start otherwise.
FIREBASE_PROJECT_ID=lrc-room-reservation
# Service-account key downloaded from the Firebase Console. Keep it OUTSIDE the repository; use forward slashes on Windows.
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/<you>/secrets/lrc-room-reservation-admin.json
# Required here because real data outlives restarts. Generate each with: openssl rand -base64 32
VOUCHER_ENCRYPTION_KEY=
APPROVAL_SECRET=
# NEVER set FIREBASE_AUTH_EMULATOR_HOST or FIRESTORE_EMULATOR_HOST: the server refuses to start if either exists.
# Live Gmail is not configured here. To enable it deliberately, put the settings of docs/gmail-smtp-setup.md in
# server/.env.cloud.mail (git-ignored) and start with `npm run server:cloud:mail`.
# Same-Wi-Fi approver test (docs/cloud-setup.md section 7): do NOT add it here. Put these three lines, with this laptop's
# IPv4 address from `ipconfig`, in server/.env.cloud.lan (git-ignored) and start with `npm run server:cloud:mail:lan`:
#   LISTEN_LAN=yes
#   APP_BASE_URL=http://192.168.43.10:5001
#   CORS_ORIGINS=http://localhost:5001,http://192.168.43.10:5001
