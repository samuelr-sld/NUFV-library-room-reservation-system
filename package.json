{
  "name": "nufv-library-services",
  "private": true,
  "type": "module",
  "scripts": {
    "emulators": "firebase emulators:start --project demo-nufv",
    "server": "node --env-file=server/.env.example server/index.js",
    "test": "npm run test:main && npm run test:tickets && npm run test:reservations",
    "bootstrap-admin": "node server/scripts/bootstrap-admin.js",
    "bootstrap-admin:dev": "node --env-file=server/.env.example server/scripts/bootstrap-admin.js",
    "release-locks": "node server/scripts/release-orphaned-locks.js",
    "release-locks:dev": "node --env-file=server/.env.example server/scripts/release-orphaned-locks.js",
    "demo": "node server/scripts/demo.js",
    "cloud:check": "node --env-file=server/.env.cloud server/scripts/cloud-check.js",
    "cloud:verify": "node --env-file=server/.env.cloud server/scripts/cloud-verify.js",
    "server:cloud": "node --env-file=server/.env.cloud server/index.js",
    "server:cloud:mail": "node --env-file=server/.env.cloud --env-file=server/.env.cloud.mail server/index.js",
    "mail:test:cloud": "node --env-file=server/.env.cloud.mail server/scripts/test-smtp.js",
    "serve:cloud": "node server/scripts/serve-public.js --port 5001",
    "serve:cloud:lan": "node server/scripts/serve-public.js --port 5001 --lan",
    "demo:lan": "node server/scripts/demo-lan.js",
    "server:cloud:mail:lan": "node --env-file=server/.env.cloud --env-file=server/.env.cloud.mail --env-file=server/.env.cloud.lan server/index.js",
    "bootstrap-admin:cloud": "node --env-file=server/.env.cloud server/scripts/bootstrap-admin.js",
    "release-locks:cloud": "node --env-file=server/.env.cloud server/scripts/release-orphaned-locks.js",
    "reconcile:cloud": "node --env-file=server/.env.cloud server/scripts/reconcile.js",
    "server:mail": "node --env-file=server/.env.example --env-file=server/.env.local server/index.js",
    "mail:test": "node --env-file=server/.env.local server/scripts/test-smtp.js",
    "demo:seed": "node --env-file=server/.env.example server/scripts/seed-demo.js",
    "demo:reset": "node --env-file=server/.env.example server/scripts/seed-demo.js --reset",
    "test:browser": "node tests/auth/nav-check.mjs",
    "test:walkthrough": "node tests/e2e/walkthrough.mjs",
    "test:ui": "node tests/e2e/ui-audit.mjs",
    "test:print": "node tests/print/print-check.mjs --out docs/evidence/print --admin admin@demo.nufv.test --silent ana.reyes@demo.nufv.test --wifi ben.cruz@demo.nufv.test --reservation carla.lim@demo.nufv.test",
    "serve-public": "node server/scripts/serve-public.js",
    "reconcile": "node server/scripts/reconcile.js",
    "reconcile:dev": "node --env-file=server/.env.example server/scripts/reconcile.js",
    "recover-admin": "node server/scripts/recover-admin.js",
    "recover-admin:dev": "node --env-file=server/.env.example server/scripts/recover-admin.js",
    "expire-tickets": "node server/scripts/expire-tickets.js",
    "expire-tickets:dev": "node --env-file=server/.env.example server/scripts/expire-tickets.js",
    "test:main": "firebase emulators:exec --project demo-nufv --only auth,firestore,hosting \"node --test tests/rules/*.test.js tests/unit/*.test.js tests/server/*.test.js tests/hosting/*.test.js\"",
    "test:tickets": "firebase emulators:exec --project demo-nufv --only auth,firestore \"node --test --test-concurrency=1 tests/tickets/*.test.js\"",
    "process-outbox": "node server/scripts/process-outbox.js",
    "process-outbox:dev": "node --env-file=server/.env.example server/scripts/process-outbox.js",
    "test:reservations": "firebase emulators:exec --project demo-nufv --only auth,firestore \"node --test --test-concurrency=1 tests/reservations/*.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.0.0",
    "jsqr": "1.4.0"
  },
  "dependencies": {
    "express": "5.3.0",
    "firebase-admin": "14.5.0",
    "nodemailer": "7.0.10",
    "qrcode": "1.5.4"
  }
}
